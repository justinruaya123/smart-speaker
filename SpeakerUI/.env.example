# Copy this file to the repository root as .env for python inference.py --mode ui.
# For direct gateway development, its private .env may stay beside this template.
# pnpm start derives APP_ORIGIN from DISPLAY_ORIGIN.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
TLS_CERT_PATH=
TLS_KEY_PATH=

# Explicit development mock. The root inference launcher supplies the CPU ONNX worker.
INFERENCE_MODE=mock
INFERENCE_URL=
INFERENCE_TOKEN=
# Integrated inference uses SMART_SPEAKER_BUNDLE supplied by its launcher.
ONNX_MODEL_DIR=./models
# Unset until the real model's score semantics and threshold are established.
INTENT_MIN_CONFIDENCE=
ACTIONS_ENABLED=false

# Disabled means no network requests, including at startup.
HA_ENABLED=false
HA_URL=
HA_TOKEN=
# Comma-separated light.*, camera.*, and temperature sensor.* IDs.
# Camera call is video only. This is the final-demo allowlist; override when needed.
HA_ENTITY_IDS=light.hue_color_lamp_1,light.dining_light,camera.dining_area_main_camera_tc70_mainstream
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Final submission GUI callback. Direct frontend development uses port 5173.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_DEVICE_ID=

LOCAL_MEDIA_DIR=./media
DATA_DIR=./data

# Live weather: the API key stays on the server. Default location is Manila.
OPENWEATHER_ENABLED=false
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=14.5995
OPENWEATHER_LON=120.9842
# Include this climate.* ID in HA_ENTITY_IDS too; device actions require opt-in.
HA_THERMOSTAT_ENTITY=
HA_CAMERA_ENTITY=camera.dining_area_main_camera_tc70_mainstream
HA_NOTIFY_ENTITY=notify.jus_phone
HA_NOTIFY_TITLE=Iris
HA_NOTIFY_MESSAGE=This works
# Optional remote MacBook target; absent this, macOS shows a local notification.
HA_MACBOOK_NOTIFY_ENTITY=
SUBMISSION_WAKE_MODE=iris_fallback
# Spoken tool results use local OS TTS and the selected speaker, without cloud TTS.
# Linux / Raspberry Pi OS: install espeak-ng. macOS and Windows use built-in voices.
# General spoken lights default to light.hue_color_lamp_1. Other named lights
# still require explicit config.toml [bindings.lights] mappings.

# Optimized pnpm start modes; APP_ORIGIN above remains the development origin.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Optional public HTTPS origin; otherwise derived from FRONTEND_HOST/PORT.
DISPLAY_ORIGIN=
# Override only when the backend runs elsewhere.
BACKEND_URL=
CHROMIUM_PATH=chromium

# Nabu Casa: HA_URL=https://<your-instance>.ui.nabu.casa (no /api suffix).
# HA_TOKEN is a Home Assistant long-lived access token, not your Nabu Casa password.
# Use a Spotify app client ID/secret and the exact production callback:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
# Keep HA_ENABLED/SPOTIFY_ENABLED false until their connection is intentionally enabled.
# Set ACTIONS_ENABLED=true to allow live GUI touch controls and accepted microphone
# commands. CLI diagnostics and recorded WAV replay never execute device actions.
# Generic "play music" resumes the active/configured Spotify Connect session.
# No song or playlist mapping is needed for generic playback.
