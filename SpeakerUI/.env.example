# Development/direct-gateway values. pnpm start derives APP_ORIGIN from DISPLAY_ORIGIN.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
TLS_CERT_PATH=
TLS_KEY_PATH=

# start.py supplies the native CPU ONNX worker settings for production.
# Mock mode is retained for offline transport tests only.
INFERENCE_MODE=mock
SMART_SPEAKER_PYTHON=
SMART_SPEAKER_ROOT=
SMART_SPEAKER_BUNDLE=
SMART_SPEAKER_THREADS=1
# The worker defaults OMP_NUM_THREADS, OPENBLAS_NUM_THREADS, MKL_NUM_THREADS,
# VECLIB_MAXIMUM_THREADS and NUMEXPR_NUM_THREADS to SMART_SPEAKER_THREADS before
# importing numeric libraries. Nonempty explicit environment values override
# these defaults; use matching values when comparing profiler and worker costs.
SMART_SPEAKER_TOKEN=
RECOGNITION_PROFILE=owner-protected
# Unset until the real model's score semantics and threshold are established.
INTENT_MIN_CONFIDENCE=
ACTIONS_ENABLED=false

# Disabled means no network requests, including at startup.
HA_ENABLED=false
HA_URL=
HA_TOKEN=
# Allowlist every bound entity: light.*, camera.*, sensor.*, climate.*,
# weather.*, media_player.*, and script.*. HA light groups use light.*;
# explicit multi-light groups may be arrays in bindings.lights.
# Append the HA ONVIF camera entity for Camera call (video only); keep existing light IDs.
HA_ENTITY_IDS=
# Optional maps; absent targets stay not_configured. No provider fallback.
# Song values use the explicitly selected provider's IDs. For local playback,
# use opaque IDs returned by /api/media/search (LOCAL_MEDIA_DIR indexes MP3s).
# CALL uses canonical contact IDs; MESSAGE has empty slots and invokes only
# messages.default, a user-supplied HA script containing its preset message.
SMART_SPEAKER_BINDINGS={"lights":{},"songs":{},"climate":{},"weather":{},"media_player":{},"contacts":{},"messages":{}}
# Example (also add all HA targets to HA_ENTITY_IDS):
# {"lights":{"light.all":["light.kitchen","light.bedroom"]},"songs":{"song.dynamite":"media-source://media_source/local/dynamite.mp3"},"climate":{"default":"climate.room"},"weather":{"default":"weather.home"},"media_player":{"provider":"home_assistant","entity_id":"media_player.room"},"contacts":{"contact.home":"script.call_home"},"messages":{"default":"script.send_preset_message"}}
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback
SPOTIFY_DEVICE_ID=

LOCAL_MEDIA_DIR=./media
DATA_DIR=./data
# Local clock/TIME zone. ALARM retains its explicit finite command timezone.
TIMEZONE=Asia/Manila

# Optimized pnpm start modes; APP_ORIGIN above remains the development origin.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Optional public HTTPS origin; otherwise derived from FRONTEND_HOST/PORT.
DISPLAY_ORIGIN=
# Override only when the backend runs elsewhere.
BACKEND_URL=
CHROMIUM_PATH=chromium

# Nabu Casa: HA_URL=https://<your-instance>.ui.nabu.casa (no /api suffix).
# HA_TOKEN is a Home Assistant long-lived access token, not your Nabu Casa password.
# Use a Spotify app client ID/secret and the exact production callback:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback
# Keep HA_ENABLED/SPOTIFY_ENABLED false until their connection is intentionally enabled.
