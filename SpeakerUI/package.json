{
  "name": "speaker-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n gateway,client 'pnpm dev:server' 'pnpm dev:client'",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "dev:client": "pnpm run bake && vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "start": "node scripts/start.mjs",
    "test": "node --import tsx --test server/**/*.test.ts src/**/*.test.ts",
    "inference:sanity": "node scripts/inference-sanity.mjs",
    "build:frontend": "pnpm run bake && vite build && node scripts/compress.mjs",
    "build:backend": "tsc -p tsconfig.server.json",
    "serve:frontend": "node --env-file-if-exists=.env scripts/frontend.mjs",
    "serve:backend": "node --env-file-if-exists=.env dist-server/server/main.js",
    "kiosk": "node scripts/kiosk.mjs",
    "bake": "node scripts/bake-assets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "playwright": "1.62.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
