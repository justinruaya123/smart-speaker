{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "paths": { "$lib/*": ["./src/lib/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "shared/**/*.ts", "vite.config.ts", "public/pcm-framer.js"]
}
