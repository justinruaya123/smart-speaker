+def replacement_plan(original_path, protocol, contract):
+    """One pre-fit, versioned replacement group; preserve all original takes."""
+    from final.tts_sanity import merge_cases
+    receipt=json.loads((ROOT/'experiments/vcm-mixed-final-v2/preparation-correction-v2.json').read_text())
+    if sha(original_path)!=receipt['original_generation_plan_sha256']:
+        raise ValueError('Changed original generation plan')
+    if (receipt['training_started'] is not False or receipt['VCM_test_results_accessed'] is not False
+            or receipt['entity']!='light.bathroom' or receipt['reference']!='turn on bathroom light'):
+        raise ValueError('Unapproved pre-fit replacement group')
+    complete=make_plan(protocol,contract)
+    case=next(r for r in merge_cases(contract) if r['spoken_text']==receipt['reference'])
+    selected=[r for r in complete if r['split']=='enrollment' and r.get('entity_id')==receipt['entity']]
+    old=json.loads(Path(original_path).read_text())
