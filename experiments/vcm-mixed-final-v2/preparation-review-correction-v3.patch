+    if old_ids!=receipt['excluded_original_ids'] or len(selected)!=3:
+        raise ValueError('Replacement scope differs from frozen original enrollment group')
+    for row in selected:
+        identity=hashlib.sha256(canonical([STUDY,'enrollment',row['voice_id'],case['spoken_text'],'light']).encode()).hexdigest()
+        row.update(id=STUDY+'/'+identity,recording_group=identity,pair_id=identity,
+                   transcript=case['spoken_text'],command=case['command'],reference_case=case['case_id'])
+    return selected
