    from scripts.test import speaker_demo_suite as suite
    original_reader = suite.read_audio
    with monkeypatch.context() as isolated:
        module, _, run, _, _ = source_replay_fixture(tmp_path, isolated)
        module.replay_evaluation(tmp_path, run, source_commit='software-fixture')
