def test_readonly_verification_reconciles_existing_outputs_without_new_inference(tmp_path, monkeypatch):
    module, _, run, _, calls = source_replay_fixture(tmp_path, monkeypatch)
    module.replay_evaluation(tmp_path, run, source_commit='software-fixture')
    before = list(calls)
    assert hasattr(module, 'verify_replay'), 'Missing immutable replay readback verifier'
    result = module.verify_replay(tmp_path, run)
    assert result['status'] == 'verified_existing_replay' and result['inference_rows'] == 5
    assert result['fresh_inference_performed'] is False and result['cached_scores_read_for_reconciliation'] is True
    assert calls == before
    path = tmp_path / run / 'replay/final-predictions.jsonl'
    path.write_text('')
    with pytest.raises(ValueError, match='identity|changed'):
        module.verify_replay(tmp_path, run)
    assert calls == before


@pytest.mark.parametrize('field,value', [
