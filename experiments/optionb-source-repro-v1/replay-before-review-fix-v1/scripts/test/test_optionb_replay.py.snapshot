@pytest.mark.parametrize('name', ['per-command.csv', 'per-intent.csv', 'per-verbatim.csv'])
def test_same_count_csv_cell_substitution_fails_with_comparison_evidence(tmp_path, monkeypatch, name):
    from scripts.test.speaker_demo_suite import read_json
    module, _, run, _, _ = source_replay_fixture(tmp_path, monkeypatch)
    load = module._load_module
    def intercept(root, relative):
        loaded = load(root, relative)
        if relative == 'scripts/test/test_speaker_optionb_tiny.py':
            evaluate = loaded.evaluate_candidate
            def corrupt(study):
                result = evaluate(study)
                path = study / name
                image = path.read_text()
                path.write_text(image.replace(',0,', ',999,', 1))
                return result
            loaded.evaluate_candidate = corrupt
        return loaded
    monkeypatch.setattr(module, '_load_module', intercept)
    with pytest.raises(ValueError, match='comparison mismatch'):
        module.replay_evaluation(tmp_path, run, source_commit='software-fixture')
    comparison = read_json(tmp_path / run / 'replay/comparison.json')
    assert comparison['csv_comparisons'][name] is False and comparison['exact'] is False
    assert not (tmp_path / run / 'replay/verification.json').exists()


