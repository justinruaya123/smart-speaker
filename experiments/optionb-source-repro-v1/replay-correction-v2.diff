+    preparation = module.prepare_evaluation(tmp_path, run)
+    assert suite.read_audio is reader
+    assert module.prepare_evaluation(tmp_path, run) == preparation
+    result = module.replay_evaluation(tmp_path, run, source_commit='software-fixture')
+    assert result['status'] == 'verified' and result['inference_rows'] == 5
+    assert len([call for call in calls if call[0] == 'infer']) == 5
+    assert len([call for call in calls if call[0] == 'prepare']) == 1
+
+
+@pytest.mark.parametrize('kind', ['directory_symlink', 'directory_junction', 'file_symlink'])
+@pytest.mark.parametrize('destination', ['inside_run', 'outside_root'])
+def test_reused_preparation_rejects_audio_links_before_wav_pcm_access(tmp_path, monkeypatch, kind, destination):
+    import os
+    import subprocess
+    from scripts.submission import optionb_reproduce as source
+    from scripts.test import speaker_demo_suite as suite
+    module, _, run, _, calls = source_replay_fixture(tmp_path, monkeypatch, real_wav=True)
+    module.prepare_evaluation(tmp_path, run)
+    audio = tmp_path / run / 'audio'
+    # Establish genuine WAV/decoded-PCM identity before moving the exact bytes.
+    for split in ('test', 'holdout'):
+        row = json.loads((tmp_path / run / 'prepared' / (split + '.jsonl')).read_text())
+        assert suite.read_audio(row, root=tmp_path).size > 0
+    outside = tmp_path.parent / (tmp_path.name + '-outside-audio')
+    target = (tmp_path / run / 'moved-audio') if destination == 'inside_run' else outside
+    if kind == 'file_symlink':
+        target.mkdir()
+        link = next(audio.glob('*.wav'))
+        moved = target / link.name
+        link.rename(moved)
+    else:
+        link, moved = audio, target
+        audio.rename(moved)
+    if kind == 'directory_junction':
+        if os.name != 'nt':
+            pytest.skip('Junction fixture requires Windows')
+        created = subprocess.run(['cmd', '/c', 'mklink', '/J', str(link), str(moved)],
+                                 capture_output=True, text=True)
+        assert created.returncode == 0, created.stdout + created.stderr
+        assert os.path.isjunction(link)
+    else:
+        try:
+            link.symlink_to(moved, target_is_directory=kind == 'directory_symlink')
+        except OSError:
+            pytest.skip('Symlinks unavailable to this test account')
+    reader, reads = suite.read_audio, []
+    def tracked_read(*args, **kwargs):
+        reads.append(True)
+        return reader(*args, **kwargs)
+    monkeypatch.setattr(suite, 'read_audio', tracked_read)
+    monkeypatch.setattr(source, 'prepare_source', lambda *a, **kw: pytest.fail('Reused receipt must not hydrate'))
+    with pytest.raises(ValueError, match='containment|link'):
+        module.replay_evaluation(tmp_path, run, source_commit='software-fixture')
+    assert reads == [] and not any(call[0] == 'infer' for call in calls)
+    assert not (tmp_path / run / 'replay/verification.json').exists()
+    failure = json.loads((tmp_path / run / 'replay/failure.json').read_text())
+    assert failure['stage'] == 'source_preparation'
