+def software_wav_bytes(pcm):
+    """Deterministic synthetic WAV; the real reader checks WAV and PCM hashes."""
+    from io import BytesIO
+    import wave
+    import numpy as np
+    stream = BytesIO()
+    with wave.open(stream, 'wb') as writer:
+        writer.setnchannels(1)
+        writer.setsampwidth(2)
+        writer.setframerate(16000)
+        writer.writeframes(np.asarray(pcm * 32768, dtype='<i2').tobytes())
+    return stream.getvalue()
 
 
