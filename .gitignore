# Single environment and generated workflow artifacts
/.venv/
/.runtime/
/.cache/
/dist/
/.worktrees/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Public dataset payloads stay local; manifests, references and licenses are versionable.
/data/audio/
/data/raw/
# Shared pool payloads; function manifests, source receipts and audits stay versionable.
/data/pool/
/data/downloads/
/data/quarantine/
# Legacy study outputs outside .cache; retain small protocols and evidence beside them.
/STT/data/features/
/STT/**/*.pt
/STT/**/*.onnx
/STT/**/*.zip
/STT/**/*.tar
/STT/**/*.gz
/experiments/**/*.pt
/experiments/**/*.onnx
/experiments/**/*.npy
/experiments/**/*.npz
# Local recordings and credentials
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.opus
.env
.env.*
!.env.example
*.log
*.tmp
.DS_Store
Thumbs.db
Desktop.ini

# Model graphs and checkpoints are local, including installed artifacts.
*.onnx
*.pt
*.pth
*.ckpt
*.tflite
*.safetensors
*.npz
*.bin

# Dataset row manifests and their large audio index stay local.
/data/**/*.jsonl
/data/audio-index.json

# Keep source, tests, compact metrics, metadata, licenses and provenance receipts in Git.

# Keyword dataset split rows reference local recordings and stay outside Git.
/data/keyword-v[34]/*_data.csv
